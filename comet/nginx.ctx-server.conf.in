# SwitchBot power button. /etc/kvmd/user/scripts/S90switchbot copies this
# from /etc/kvmd/user/switchbot at boot; edit it there.

# GL's index.html with the button's script tag, rendered into /run at boot.
# Falls back to GL's own file if the rendered copy is missing.
location = /index.html {
	root /run/switchbot/www;
	try_files /index.html @switchbot_glweb;
	add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0";
	expires -1;
	auth_request off;
}

location @switchbot_glweb {
	root /usr/share/kvmd/glweb;
	try_files /index.html =404;
	add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0";
	expires -1;
	auth_request off;
}

location = /switchbot/ui.js {
	alias /etc/kvmd/user/switchbot/ui.js;
	add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0";
	expires -1;
	auth_request off;
}

# Inherits the server's auth_request, so only a logged-in KVM session gets
# through to the Bluetooth node.
location /switchbot/api/ {
	proxy_pass http://@NODE@/api/;
	proxy_set_header Authorization "Bearer @TOKEN@";
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_connect_timeout 5s;
	proxy_read_timeout 120s;
}
